<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the docs' compiled-tree examples: each block in Examples.fs is run once with the
       library's TreeHook set (by reflection), its tree rendered as C#-like source, and written
       between the tree:name markers in the docs; the check argument fails if they are stale.
         dotnet run -c Release (project docs/trees), optionally followed by: check -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Examples.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="AgileObjects.ReadableExpressions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FSharp.Interop.Dlr\FSharp.Interop.Dlr.fsproj" />
  </ItemGroup>

</Project>
