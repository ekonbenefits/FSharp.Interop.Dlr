<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Published dependency floor for the library, and what the test projects run against, so
         the floor is what the suite proves. 10.1 is the lowest that works: its
         LeafExpressionConverter is the first to convert Sequential, PropertySet, VarSet and
         FieldSet (every unit block, let mutable and let rec needs one) and to convert a Let
         without a nested lambda. The package is netstandard2.0; the compiler that builds
         against it must be SDK 10's (README). -->
    <PackageVersion Include="FSharp.Core" Version="10.1.201" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PackageVersion Include="AnyUnit.TestingPlatform" Version="1.3.0" />
    <PackageVersion Include="AnyUnit.Style.Xunit" Version="1.3.0" />
    <PackageVersion Include="AnyUnit.Style.FsUnit" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="FSharp.Analyzers.SDK" Version="0.39.2" />
    <PackageVersion Include="FSharp.Analyzers.SDK.Testing" Version="0.39.2" />
    <PackageVersion Include="FSharp.Analyzers.Build" Version="0.5.0" />
    <!-- The build companion's (#216): the version FSharp.Analyzers.SDK 0.39.2 uses, matching SDK 10.0.400's compiler. -->
    <PackageVersion Include="FSharp.Compiler.Service" Version="43.12.400" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <!-- Real-world dynamic targets exercised by the tests. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="pythonnet" Version="3.1.0" />
    <PackageVersion Include="IronPython" Version="3.4.2" />
    <PackageVersion Include="NLua" Version="1.7.9" />
    <PackageVersion Include="System.Management.Automation" Version="7.6.6" />
    <PackageVersion Include="Dapper" Version="2.1.86" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FSharp.Interop.Dynamic" Version="7.0.0" />
    <PackageVersion Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageVersion Include="AgileObjects.ReadableExpressions" Version="4.1.3" />
  </ItemGroup>
</Project>
