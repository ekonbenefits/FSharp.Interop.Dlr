<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Published dependency floor for the library; Tests override to a current version.
         6.0 is the lowest that works: against older FSharp.Core the current compiler does not
         inline enum operators (|||, int), which then hit FSharp.Core's throwing dynamic path. -->
    <PackageVersion Include="FSharp.Core" Version="6.0.1" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PackageVersion Include="AnyUnit.TestingPlatform" Version="1.2.2" />
    <PackageVersion Include="AnyUnit.Style.Xunit" Version="1.2.2" />
    <PackageVersion Include="AnyUnit.Style.FsUnit" Version="1.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="FSharp.Analyzers.SDK" Version="0.39.2" />
    <PackageVersion Include="FSharp.Analyzers.SDK.Testing" Version="0.39.2" />
    <PackageVersion Include="FSharp.Analyzers.Build" Version="0.5.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <!-- Real-world dynamic targets exercised by the tests. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="pythonnet" Version="3.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>
</Project>
