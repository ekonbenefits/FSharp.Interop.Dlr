<Project Sdk="Microsoft.NET.Sdk">

  <!-- Differential test of captures (#200): generate.fsx writes Cases/*.g.fs, this program runs
       them, and compare.fsx checks Release against Debug. ./run.sh does all three. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);FS0064;FS1182</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="Cases/*.g.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- The build companion's capture map (prototype): Companion/capturemap.fsx writes it from the
       Release build's fsc arguments; -p:DlrCaptureMap=<path> embeds it. -->
  <ItemGroup Condition="'$(DlrCaptureMap)' != ''">
    <EmbeddedResource Include="$(DlrCaptureMap)" LogicalName="FSharp.Interop.Dlr.CaptureMap" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.Interop.Dlr\FSharp.Interop.Dlr.fsproj" />
  </ItemGroup>

</Project>
