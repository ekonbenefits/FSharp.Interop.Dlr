<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <WarnOn>1182</WarnOn>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <RepositoryUrl>https://github.com/ekonbenefits/FSharp.Interop.Dlr.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Version comes from git tags (MinVer): a `v*` tag is the version, and an untagged commit is
       the next pre-release above the floor below (1.0.0-alpha.<height> until v1.0.0 exists).
       Raise the floor to declare the next release; cut the tag to make it. CI checks out with
       full history so the tag and the height are visible to it. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!-- Which FSharp.Core the test projects run against. Default: the library's floor (from
       Directory.Packages.props), so the floor is what the suite proves. `-p:FSharpCore=latest` runs
       the same projects on the newest release, to see what is coming; `-p:FSharpCore=<version>`
       any other. (A global property cannot be reassigned, hence the second, resolved one.) Keep
       FSharpCoreLatest current. -->
  <PropertyGroup>
    <FSharpCoreLatest>10.1.401</FSharpCoreLatest>
    <FSharpCoreResolved Condition="'$(FSharpCore)' == 'latest'">$(FSharpCoreLatest)</FSharpCoreResolved>
    <FSharpCoreResolved Condition="'$(FSharpCore)' != '' and '$(FSharpCore)' != 'latest'">$(FSharpCore)</FSharpCoreResolved>
  </PropertyGroup>

  <!-- The 11.0 compiler builds a block's state machine in Debug too (10.0.400 does not;
       dotnet/fsharp#20469), so a capture the machine cannot hold fails there at compile time, as
       in task { } (Tests/Cache.fs). -->
  <PropertyGroup Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">
    <DefineConstants>$(DefineConstants);COMPILER_11</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
</Project>
