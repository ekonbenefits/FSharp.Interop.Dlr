<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <WarnOn>1182</WarnOn>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Version comes from git tags (MinVer): a `v*` tag is the version, and an untagged commit is
       the next pre-release above the floor below (0.1.0-alpha.<height> until v0.1.0 exists).
       Raise the floor to declare the next release; cut the tag to make it. CI checks out with
       full history so the tag and the height are visible to it. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
</Project>
