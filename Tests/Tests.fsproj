<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 exercises the library's netstandard2.0 build (and Microsoft.CSharp from a package)
         on the runtime that actually consumes it. On by default where it can run (Windows);
         -p:TestNet48=true adds it elsewhere, e.g. to check that it still compiles. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(TestNet48)' == 'true'">net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- AnyUnit's MTP adapter generates the entry point. OutputType is set here rather than
         left to the adapter: it sets it too, but from package targets, which is too late for
         the net48 build to be named .exe. -->
    <OutputType>Exe</OutputType>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" VersionOverride="10.1.401" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="AnyUnit.TestingPlatform" />
    <PackageReference Include="AnyUnit.Style.Xunit" />
    <PackageReference Include="AnyUnit.Style.FsUnit" />
    <PackageReference Include="coverlet.MTP" />
    <!-- Dogfood: FSharp.Analyzers.Build runs the repo's own analyzer over this project after it
         compiles (the fsharp-analyzers tool comes from .config/dotnet-tools.json). Unreflected.fs
         carries the one intentional DLR001 behind an ignore-line comment. -->
    <PackageReference Include="FSharp.Analyzers.Build" PrivateAssets="all" />
  </ItemGroup>

  <!-- Only so the analyzer builds first; skipped when analyzers are off (-p:RunAnalyzers=false),
       which the older-SDK CI legs pass since the analyzer project targets net10.0. -->
  <ItemGroup Condition="'$(RunAnalyzers)' != 'false'">
    <ProjectReference Include="..\FSharp.Interop.Dlr.Analyzers\FSharp.Interop.Dlr.Analyzers.fsproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <PropertyGroup>
    <FSharpAnalyzersOtherFlags>--analyzers-path "$(MSBuildThisFileDirectory)../FSharp.Interop.Dlr.Analyzers/bin/$(Configuration)/net10.0" --code-root "$(MSBuildThisFileDirectory).."</FSharpAnalyzersOtherFlags>
    <RunAnalyzers Condition="'$(TargetFramework)' == 'net10.0'">true</RunAnalyzers>
    <!-- An analyzer error is a build error, not a warning. -->
    <FSharpAnalyzersContinueOnError>false</FSharpAnalyzersContinueOnError>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="Members.fs" />
    <Compile Include="Invoke.fs" />
    <Compile Include="Set.fs" />
    <Compile Include="Operators.fs" />
    <Compile Include="Index.fs" />
    <Compile Include="Body.fs" />
    <Compile Include="Cache.fs" />
    <Compile Include="Loops.fs" />
    <Compile Include="DynamicObjects.fs" />
    <Compile Include="TryBlocks.fs" />
    <Compile Include="Unary.fs" />
    <Compile Include="Nesting.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="ComputedNames.fs" />
    <Compile Include="Pipes.fs" />
    <Compile Include="CompoundAssign.fs" />
    <Compile Include="Unreflected.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.Interop.Dlr\FSharp.Interop.Dlr.fsproj" />
  </ItemGroup>
</Project>
