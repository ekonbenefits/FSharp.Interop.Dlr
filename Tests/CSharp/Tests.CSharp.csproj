<Project Sdk="Microsoft.NET.Sdk">

  <!-- Types the F# tests cannot declare: a C# `internal` class with public members and an
       anonymous type, for the accessibility of a *declaring type* (docs/restrictions.md). And C#
       `dynamic` itself, as the baseline a real-target test compares with (ComEvents.cs). -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inbox on .NET (Core); a package only for netstandard2.0, as in the library. A build that
         overrides TargetFrameworks (CI's dotnet11 job) otherwise hits NU1510. -->
    <PackageReference Include="Microsoft.CSharp" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
