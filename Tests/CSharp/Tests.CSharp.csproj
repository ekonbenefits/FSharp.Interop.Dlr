<Project Sdk="Microsoft.NET.Sdk">

  <!-- Types the F# tests cannot declare: a C# `internal` class with public members and an
       anonymous type, for the accessibility of a *declaring type* (docs/restrictions.md). -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
