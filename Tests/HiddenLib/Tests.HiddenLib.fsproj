<Project Sdk="Microsoft.NET.Sdk">

  <!-- A reflected definition calling a function its signature file hides (#213): in Release the
       optimizer inlines and erases the function, the stored quotation still names it, and
       FSharp.Core cannot decode any of this assembly's reflected definitions. Its own assembly,
       since that failure takes every block in the assembly with it. Tests/Hidden.fs calls in. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Hidden.fsi" />
    <Compile Include="Hidden.fs" />
    <Compile Include="Elsewhere.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Condition="'$(FSharpCoreResolved)' == ''" />
    <PackageReference Include="FSharp.Core" VersionOverride="$(FSharpCoreResolved)" Condition="'$(FSharpCoreResolved)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FSharp.Interop.Dlr\FSharp.Interop.Dlr.fsproj" />
  </ItemGroup>

</Project>
