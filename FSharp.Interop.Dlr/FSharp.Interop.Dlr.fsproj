<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>FSharp.Interop.Dlr</AssemblyName>
    <PackageId>FSharp.Interop.Dlr</PackageId>
    <RootNamespace>FSharp.Interop.Dlr</RootNamespace>
    <Description>dlr { } for F#: dynamic member access with ?, compiled once per block into DLR call sites</Description>
    <Authors>Jay Tuley</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ekonbenefits/FSharp.Interop.Dlr</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>fsharp dynamic dlr quotations</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Strong-named so strong-named .NET Framework apps can reference it (an unsigned assembly
         they cannot; unsigned apps take a signed one either way). The key is public, as
         Microsoft recommends for open-source libraries: it gives the assembly a stable identity,
         not proof of who built it. Never change it: the key is part of that identity. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FSharp.Interop.Dlr.snk</AssemblyOriginatorKeyFile>
    <!-- JIT only: the C# runtime binder, LambdaExpression.Compile and ReflectedDefinition lookup
         all need dynamic code and untrimmed metadata (see README). -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.CSharp" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- DynamicMethod for the function-to-delegate factories; inbox on net10.0. -->
    <PackageReference Include="System.Reflection.Emit.Lightweight" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\License.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Operators.fsi" />
    <Compile Include="Operators.fs" />
    <Compile Include="Adapters.fs" />
    <Compile Include="Runtime.fs" />
    <Compile Include="Reflection.fs" />
    <Compile Include="Functions.fs" />
    <Compile Include="Seam.fs" />
    <Compile Include="SiteCaches.fs" />
    <Compile Include="Binders.fs" />
    <Compile Include="CaptureMap.fs" />
    <Compile Include="BodyMap.fs" />
    <Compile Include="TranslatePatterns.fs" />
    <Compile Include="SiteHoister.fs" />
    <Compile Include="TranslateBlock.fs" />
    <Compile Include="TranslateMembers.fs" />
    <Compile Include="Translate.fs" />
    <Compile Include="Discover.fs" />
    <Compile Include="Cache.fs" />
    <Compile Include="Builder.fsi" />
    <Compile Include="Builder.fs" />
  </ItemGroup>
</Project>
