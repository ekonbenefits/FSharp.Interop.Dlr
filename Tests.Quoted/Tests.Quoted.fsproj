<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Tests sources compiled with `dlr` shadowed by `dlrq` (Shim.fs), so the shared
       semantics run over both builders. Left out: Cache.fs, HotPath.fs and Unreflected.fs, which
       test dlr's own mechanism (closure-type keys, nanosecond entry, the DLR001 error). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <OutputType>Exe</OutputType>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
    <DefineConstants>$(DefineConstants);DLRQ</DefineConstants>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" VersionOverride="10.1.401" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="AnyUnit.TestingPlatform" />
    <PackageReference Include="AnyUnit.Style.Xunit" />
    <PackageReference Include="AnyUnit.Style.FsUnit" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="pythonnet" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.ClearScript.V8" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Shim.fs" />
    <Compile Include="..\Tests\AssemblyInfo.fs" Link="AssemblyInfo.fs" />
    <Compile Include="..\Tests\Fixtures.fs" Link="Fixtures.fs" />
    <Compile Include="..\Tests\Members.fs" Link="Members.fs" />
    <Compile Include="..\Tests\Invoke.fs" Link="Invoke.fs" />
    <Compile Include="..\Tests\Set.fs" Link="Set.fs" />
    <Compile Include="..\Tests\Operators.fs" Link="Operators.fs" />
    <Compile Include="..\Tests\Index.fs" Link="Index.fs" />
    <Compile Include="..\Tests\Body.fs" Link="Body.fs" />
    <Compile Include="..\Tests\Loops.fs" Link="Loops.fs" />
    <Compile Include="..\Tests\DynamicObjects.fs" Link="DynamicObjects.fs" />
    <Compile Include="..\Tests\TryBlocks.fs" Link="TryBlocks.fs" />
    <Compile Include="..\Tests\Unary.fs" Link="Unary.fs" />
    <Compile Include="..\Tests\Nesting.fs" Link="Nesting.fs" />
    <Compile Include="..\Tests\Errors.fs" Link="Errors.fs" />
    <Compile Include="..\Tests\ComputedNames.fs" Link="ComputedNames.fs" />
    <Compile Include="..\Tests\Pipes.fs" Link="Pipes.fs" />
    <Compile Include="..\Tests\CompoundAssign.fs" Link="CompoundAssign.fs" />
    <Compile Include="..\Tests\Restrictions.fs" Link="Restrictions.fs" />
    <Compile Include="..\Tests\FunctionMembers.fs" Link="FunctionMembers.fs" />
    <Compile Include="..\Tests\Polymorphic.fs" Link="Polymorphic.fs" />
    <Compile Include="..\Tests\Constructors.fs" Link="Constructors.fs" />
    <Compile Include="..\Tests\Mutables.fs" Link="Mutables.fs" />
    <Compile Include="..\Tests\Delegates.fs" Link="Delegates.fs" />
    <Compile Include="..\Tests\StaticOverloads.fs" Link="StaticOverloads.fs" />
    <Compile Include="..\Tests\JsonNet.fs" Link="JsonNet.fs" />
    <Compile Include="..\Tests\PythonNet.fs" Link="PythonNet.fs" />
    <Compile Include="..\Tests\DapperRows.fs" Link="DapperRows.fs" />
    <Compile Include="..\Tests\ClearScriptV8.fs" Link="ClearScriptV8.fs" />
    <Compile Include="..\Tests\FSharpInBlocks.fs" Link="FSharpInBlocks.fs" />
    <Compile Include="..\Tests\RulesEverywhere.fs" Link="RulesEverywhere.fs" />
    <Compile Include="..\Tests\Quoted.fs" Link="Quoted.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.Interop.Dlr\FSharp.Interop.Dlr.fsproj" />
  </ItemGroup>
</Project>
