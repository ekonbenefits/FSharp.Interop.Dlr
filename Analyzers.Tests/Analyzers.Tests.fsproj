<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <EnableAnyUnitRunner>true</EnableAnyUnitRunner>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- FSharp.Analyzers.SDK pins FSharp.Core exactly (it must match the editor host); keep in step. -->
    <PackageReference Include="FSharp.Core" VersionOverride="10.1.400" />
    <PackageReference Include="AnyUnit.TestingPlatform" />
    <PackageReference Include="AnyUnit.Style.Xunit" />
    <PackageReference Include="AnyUnit.Style.FsUnit" />
    <PackageReference Include="FSharp.Analyzers.SDK.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ReflectedDefinitionTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.Interop.Dlr.Analyzers\FSharp.Interop.Dlr.Analyzers.fsproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
